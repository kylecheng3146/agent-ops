{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kylecheng3146/agent-ops/schemas/evidence.schema.json",
  "title": "Agent Ops verification evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "taskId",
    "criterionId",
    "commandId",
    "argv",
    "cwd",
    "scope",
    "startedAt",
    "finishedAt",
    "exitCode",
    "testCount",
    "toolVersions",
    "configHash"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "taskId": {
      "$ref": "#/$defs/id"
    },
    "criterionId": {
      "$ref": "#/$defs/id"
    },
    "commandId": {
      "$ref": "#/$defs/id"
    },
    "argv": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[^\\u0000]*$"
      }
    },
    "cwd": {
      "$ref": "#/$defs/relativePath"
    },
    "scope": {
      "enum": ["project", "user"]
    },
    "startedAt": {
      "type": "string",
      "format": "date-time"
    },
    "finishedAt": {
      "type": "string",
      "format": "date-time"
    },
    "exitCode": {
      "type": ["integer", "null"],
      "minimum": 0,
      "maximum": 4294967295
    },
    "testCount": {
      "type": ["integer", "null"],
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "toolVersions": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "\\S"
      }
    },
    "configHash": {
      "$ref": "#/$defs/hash"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,127}$"
    },
    "hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "relativePath": {
      "type": "string",
      "pattern": "^(?:\\.|(?![A-Za-z]:)(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*)$",
      "allOf": [
        {
          "not": {
            "pattern": "(?:^|/)(?:[Aa][Uu][Xx]|[Cc][Oo][Mm][1-9]|[Cc][Oo][Nn]|[Ll][Pp][Tt][1-9]|[Nn][Uu][Ll]|[Pp][Rr][Nn])(?:\\.[A-Za-z0-9._-]*)?(?:/|$)"
          }
        },
        {
          "not": {
            "pattern": "\\.(?:/|$)"
          }
        }
      ]
    }
  },
  "$comment": "Timestamp ordering is a semantic constraint enforced by runtime validation."
}
