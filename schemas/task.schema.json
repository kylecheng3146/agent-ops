{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kylecheng3146/agent-ops/schemas/task.schema.json",
  "title": "Agent Ops task",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "title", "criteria"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "title": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "parentTaskId": {
      "$ref": "#/$defs/id"
    },
    "criteria": {
      "type": "array",
      "minItems": 2,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description", "verifierIds"],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "description": {
            "$ref": "#/$defs/nonEmptyString"
          },
          "verifierIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/id"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,127}$"
    },
    "nonEmptyString": {
      "type": "string",
      "pattern": "[^\\s\\u0000]",
      "not": {
        "pattern": "\\u0000"
      }
    }
  },
  "$comment": "Criterion ID uniqueness is a semantic constraint enforced by runtime validation."
}
