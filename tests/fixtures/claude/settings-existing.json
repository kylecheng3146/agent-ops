{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": ["Read(./secrets/**)"]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "McpTool",
        "hooks": [
          {
            "type": "command",
            "command": "user-policy",
            "args": ["check"]
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["/old/agent-ops/hook-entry.js", "claude", "legacy"]
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "user-audit append"
          }
        ]
      }
    ]
  }
}
