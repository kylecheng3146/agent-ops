{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": ["Read(./secrets/**)"]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "McpTool",
        "hooks": [
          {
            "type": "command",
            "command": "user-policy",
            "args": ["check"]
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "/old/agent-ops/hook-entry.js",
              "claude",
              "legacy",
              "--managed-by=agent-ops"
            ]
          },
          {
            "type": "command",
            "command": "node",
            "args": ["/user/hook.js", "claude", "custom"]
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "user-audit append"
          }
        ]
      }
    ]
  }
}
